command -v pnpm >/dev/null || PATH="$HOME/.local/share/pnpm/bin:$HOME/.local/share/pnpm:$PATH"

pushing_to_main=false

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    pushing_to_main=true
    break
  fi
done

if [ "$pushing_to_main" = true ]; then
  echo "Push targets main — running Playwright tests..."
  pnpm --dir frontend exec playwright test || exit 1
fi
