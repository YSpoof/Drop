{
  "name": "drop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && husky",
    "precommit": "lint-staged",
    "prepush": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
    "start": "node build/server.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "native": "pnpx @neutralinojs/neu",
    "native:update": "pnpm native update",
    "native:dev": "pnpm native run",
    "native:build": "pnpm native build --release --embed-resources",
    "native:preview": "./dist/Drop/Drop-linux_x64"
  },
  "dependencies": {
    "desfetch": "^1.2.1",
    "fastrtc": "^1.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@neutralinojs/lib": "^6.9.0",
    "@neutralinojs/neu": "^11.7.2",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "next",
    "@sveltejs/kit": "next",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "client-zip": "^2.5.1",
    "daisyui": "^5.7.43",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "localforage": "^1.10.0",
    "oxfmt": "^0.70.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-comp-lazyloader": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0",
    "vite-plugin-sveltekit-ws": "^2.1.1"
  },
  "lint-staged": {
    "*.{json,ts,js,svelte}": "oxfmt"
  },
  "packageManager": "pnpm@12.6.0"
}
