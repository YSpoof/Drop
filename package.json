{
  "name": "drop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && husky",
    "precommit": "lint-staged",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "start": "node build/server.js"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "client-zip": "^2.5.0",
    "daisyui": "^5.7.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "localforage": "^1.10.0",
    "oxfmt": "^0.61.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.0"
  },
  "lint-staged": {
    "*.{json,ts,js,svelte}": "oxfmt"
  },
  "packageManager": "pnpm@11.18.0"
