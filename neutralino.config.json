{
  "applicationId": "br.com.lzart.drop",
  "applicationName": "Drop",
  "author": "LZart",
  "copyright": "LZart",
  "description": "Compartilhe arquivos de forma simplificada",
  "version": "1.0.0",
  "defaultMode": "chrome",
  "documentRoot": "/",
  "url": "https://drop.lzart.com.br",
  "port": 65173,
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "extensions": [
    {
      "id": "br.com.lzart.drop.streamer"
    }
  ],
  "tokenSecurity": "one-time",
  "nativeAllowList": [
    "app.*",
    "events.*",
    "extensions.dispatch",
    "extensions.getStats",
    "filesystem.*",
    "os.getPath",
    "os.showOpenDialog",
    "os.showFolderDialog",
    "os.execCommand",
    "clipboard.writeText",
    "computer.getOSInfo",
    "resources.*"
  ],
  "modes": {
    "window": {
      "icon": "static/images/pwa/512.png"
    },
    "chrome": {
      "width": 1024,
      "height": 768
    }
  },
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "cli": {
    "binaryName": "Drop",
    "resourcesPath": "/native/extensions/compiled/",
    "resourcesExclude": "node_modules|chromedata|\\.git|\\.svelte-kit|dist|\\.tmp|openspec|playwright-report|test-results",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0",
    "frontendLibrary": {
      "projectPath": ".",
      "devUrl": "http://localhost:4321",
      "initCommand": "pnpm install",
      "devCommand": "pnpm run dev"
    }
  }
}
