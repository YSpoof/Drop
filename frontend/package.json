{
  "name": "drop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && husky",
    "precommit": "lint-staged",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "client-zip": "^2.5.1",
    "desfetch": "^1.2.1",
    "fastrtc": "^1.2.1",
    "localforage": "^1.10.0",
    "quick-di": "^1.0.0",
    "svelte-comp-lazyloader": "^1.0.1"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "daisyui": "^5.7.50",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.5",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{json,ts,js,svelte}": "oxfmt"
  },
  "packageManager": "pnpm@12.16.1"
}
